{
  "name": "@capraconsulting/webapp-deploy-lambda",
  "version": "0.0.0-development",
  "description": "CDK construct for deploying a webapp release to S3 and CloudFront",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/capralifecycle/webapp-deploy-lambda"
  },
  "scripts": {
    "build": "./build.sh && tsc",
    "watch": "tsc -w",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:update": "node --test --test-update-snapshots \"src/**/*.test.ts\"",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "fmt": "biome format --write",
    "fmt:check": "biome format",
    "prepare": "npm run build && husky",
    "semantic-release": "semantic-release",
    "upgrade-dependencies": "ncu --upgrade --install always --format group --reject @types/node",
    "biome-migrate": "biome migrate --write"
  },
  "keywords": [
    "cdk",
    "cloudfront",
    "deployment",
    "s3",
    "webapp"
  ],
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist/webapp_deploy",
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@liflig/cdk-snapshot": "1.0.1",
    "@types/node": "24.13.3",
    "aws-cdk-lib": "2.267.0",
    "constructs": "10.8.1",
    "husky": "9.1.7",
    "npm-check-updates": "23.1.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  }
}
